# /etc/harkesh-backup/env (chmod 600, root) — NE PAS committer la version remplie.
# Dépôt restic sur la Hetzner Storage Box, via l'alias SSH "storagebox" défini dans /root/.ssh/config
# (port 23, clé dédiée — cf. README « Sauvegardes »)
RESTIC_REPOSITORY=sftp:storagebox:restic
# Mot de passe restic : AUSSI dans 1Password (vault k8s-home) — sans lui, les sauvegardes sont illisibles
RESTIC_PASSWORD_FILE=/etc/harkesh-backup/restic-password
# Débit d'envoi max en KiB/s ; vide = illimité (fibre 2 Gb/s : pas de limite)
RESTIC_LIMIT_UPLOAD=
# Alerte en cas d'échec (ntfy est en deny-all : token d'un utilisateur autorisé à publier)
NTFY_URL=https://ntfy.axtazer.me/harkesh-backup
NTFY_TOKEN=
