        },
        "definition": "label_values(container_last_seen{job=\"cadvisor\", name!=\"\"}, name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
